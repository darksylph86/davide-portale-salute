----
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

// Recupera gli ultimi 3 articoli del blog ordinati per data
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 4rem 0;
				background: #f4f4f5; /* Grigio chiarissimo elegante */
				border-radius: 12px;
				margin-bottom: 3rem;
			}
			.hero h1 { font-size: 3rem; margin-bottom: 0.5rem; color: #2c3e50; }
			.hero p { font-size: 1.2rem; color: #555; max-width: 800px; margin: 0 auto; }
			.hero-titles { font-weight: bold; color: #e74c3c; margin-bottom: 1rem; display: block;}
			
			.latest-posts { margin-top: 3rem; }
			.latest-posts h2 { border-bottom: 2px solid #eee; padding-bottom: 0.5rem; margin-bottom: 2rem; }
			
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style: none;
				padding: 0;
			}
			.post-card {
				border: 1px solid #eee;
				border-radius: 8px;
				overflow: hidden;
				transition: transform 0.2s;
			}
			.post-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
			.post-card img { width: 100%; height: 200px; object-fit: cover; }
			.post-content { padding: 1.5rem; }
			.title { margin: 0 0 0.5rem 0; font-size: 1.25rem; line-height: 1.2; }
			.date { font-size: 0.85rem; color: #888; }
			a { text-decoration: none; color: inherit; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			
			<div class="hero">
				<h1>Dr. Davide Ferraro</h1>
				<span class="hero-titles">Farmacista | Dottore in Nutrizione Umana | Diplomato SANIS</span>
				<p>
					Divulgazione scientifica su nutrizione, integrazione e benessere. 
					Niente mode, solo biochimica e fisiologia applicate alla vita reale.
				</p>
			</div>

			<section class="latest-posts">
				<h2>🆕 Ultimi Aggiornamenti</h2>
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<div class="post-content">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div style="text-align: center; margin-top: 2rem;">
					<a href="/blog" style="text-decoration: underline;">Vedi tutti gli articoli →</a>
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>